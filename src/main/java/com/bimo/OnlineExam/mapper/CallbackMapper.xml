<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bimo.OnlineExam.mapper.CallbackMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.bimo.OnlineExam.pojo.Callback">
        <id column="id" property="id" />
        <result column="title" property="title" />
        <result column="content" property="content" />
        <result column="callback_content" property="callbackContent" />
        <result column="status" property="status" />
        <result column="uploader" property="uploader" />
        <result column="upload_time" property="uploadTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, title, content, callback_content, status, uploader, upload_time
    </sql>

</mapper>
