<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bimo.OnlineExam.mapper.ExamMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.bimo.OnlineExam.pojo.Exam">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="upload_time" property="uploadTime" />
        <result column="start_time" property="startTime" />
        <result column="end_time" property="endTime" />
        <result column="available_score" property="availableScore" />
        <result column="uploader" property="uploader" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, name, upload_time, start_time, end_time, available_score, uploader
    </sql>

</mapper>
